    // Funciones para Variables de Entorno (Vercel / Render style)
    function addEnvRow(key = '', value = '') {
      const container = document.getElementById('env-variables-list');
      const row = document.createElement('div');
      row.className = 'env-row';
      const inputType = showEnvValues ? 'text' : 'password';
      
      row.innerHTML = `
        <input type="text" class="form-control" value="${key}" placeholder="Key (e.g. PORT)">
        <input type="${inputType}" class="form-control" value="${value}" placeholder="Value">
        <button class="btn-icon" onclick="removeEnvRow(this)" title="Delete variable">‚úï</button>
      `;
      container.appendChild(row);
    }

    function removeEnvRow(btn) {
      const row = btn.parentElement;
      row.remove();
    }

    function toggleEnvVisibility() {
      showEnvValues = !showEnvValues;
      const inputs = document.querySelectorAll('#env-variables-list input[placeholder="Value"]');
      const btn = document.getElementById('btn-toggle-env');

      inputs.forEach(input => {
        input.type = showEnvValues ? 'text' : 'password';
      });

      btn.innerText = showEnvValues ? 'üîí Hide Values' : 'üëÅ Show Values';
    }

    function importEnvFile() {
      const sampleEnvs = [
        { key: 'PORT', val: '8080' },
        { key: 'REDIS_URL', val: 'redis://localhost:6379' },
        { key: 'CORS_ORIGIN', val: '*' }
      ];

      sampleEnvs.forEach(env => addEnvRow(env.key, env.val));
      alert('¬°Variables importadas correctamente desde el entorno local!');
    }

    // Sincronizar endpoints activos seleccionados con el panel de estr√©s
    function updateEndpointSelector() {
      const selector = document.getElementById('endpoint-selector');
      const metricsContainer = document.getElementById('metrics-container');
      const checkboxes = document.querySelectorAll('.endpoint-toggle[data-endpoint]:checked');

      selector.innerHTML = '<option value="ALL">‚ö° ALL ACTIVE GENERATED ENDPOINTS (Simultaneous)</option>';
      metricsContainer.innerHTML = '';

      checkboxes.forEach(cb => {
        const ep = cb.getAttribute('data-endpoint');
        const parentGroup = cb.closest('.table-group');
        if (parentGroup && parentGroup.classList.contains('disabled')) return;

        const opt = document.createElement('option');
        opt.value = ep;
        opt.innerText = ep;
        selector.appendChild(opt);

        const method = ep.split(' ')[0].toLowerCase();
        const row = document.createElement('div');
        row.className = 'endpoint-row';
        row.innerHTML = `
          <span class="badge badge-${method}">${ep}</span>
          <span id="metric-${ep}" style="font-family: monospace; color: var(--text-muted);">Latency: -- ms | Req/sec: --</span>
        `;
        metricsContainer.appendChild(row);
      });
    }

    function initCharts() {
      const isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      const textColor = isDark ? '#9ca3af' : '#6b7280';
      const gridColor = isDark ? '#374151' : '#e5e7eb';

      const commonOptions = {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 200 },
        scales: {
          x: { ticks: { color: textColor }, grid: { color: gridColor } },
          y: { ticks: { color: textColor }, grid: { color: gridColor }, beginAtZero: true }
        },
        plugins: {
          legend: { labels: { color: textColor } }
        }
      };

      const ctx1 = document.getElementById('latencyChart').getContext('2d');
      latencyChart = new Chart(ctx1, {
        type: 'line',
        data: {
          labels: ['0s'],
          datasets: [{
            label: 'Latencia Promedio (ms)',
            data: [0],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.2)',
