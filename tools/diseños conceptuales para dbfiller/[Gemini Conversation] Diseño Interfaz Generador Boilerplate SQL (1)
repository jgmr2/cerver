    let isTesting = false;
    let testInterval = null;
    let latencyChart, rpsChart;

    function toggleTableGroup(groupId, isChecked) {
      const group = document.getElementById(groupId);
      if (group) {
        if (isChecked) {
          group.classList.remove('disabled');
        } else {
          group.classList.add('disabled');
        }
      }
    }

    // Inicializaci√≥n de Gr√°ficas de Chart.js
    function initCharts() {
      const isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      const textColor = isDark ? '#9ca3af' : '#6b7280';
      const gridColor = isDark ? '#374151' : '#e5e7eb';

      const commonOptions = {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 200 },
        scales: {
          x: { ticks: { color: textColor }, grid: { color: gridColor } },
          y: { ticks: { color: textColor }, grid: { color: gridColor }, beginAtZero: true }
        },
        plugins: {
          legend: { labels: { color: textColor } }
        }
      };

      // Gr√°fica Latencia
      const ctx1 = document.getElementById('latencyChart').getContext('2d');
      latencyChart = new Chart(ctx1, {
        type: 'line',
        data: {
          labels: ['0s'],
          datasets: [{
            label: 'Latencia Promedio (ms)',
            data: [0],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.2)',
            fill: true,
            tension: 0.3
          }]
        },
        options: commonOptions
      });

      // Gr√°fica Req/sec
      const ctx2 = document.getElementById('rpsChart').getContext('2d');
      rpsChart = new Chart(ctx2, {
        type: 'line',
        data: {
          labels: ['0s'],
          datasets: [{
            label: 'Requests / sec (AB)',
            data: [0],
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.2)',
            fill: true,
            tension: 0.3
          }]
        },
        options: commonOptions
      });
    }

    window.onload = () => {
      initCharts();
    };

    // Cambiar entre pesta√±as
    function switchTab(tabId) {
      const tabs = document.querySelectorAll('.tab');
      const panels = document.querySelectorAll('.view-panel');

      tabs.forEach(tab => tab.classList.remove('active'));
      panels.forEach(panel => panel.classList.remove('active'));

      const selectedPanel = document.getElementById('panel-' + tabId);
      if (selectedPanel) {
        selectedPanel.classList.add('active');
      }

      const activeTabIndex = ['schema', 'gen', 'docker', 'stress'].indexOf(tabId);
      if (activeTabIndex !== -1) {
        tabs[activeTabIndex].classList.add('active');
      }
    }

    // Control del test de estr√©s
    function toggleStressTest() {
      const btn = document.getElementById('btn-stress');
      const statusMonitor = document.getElementById('status-monitor');

      if (!isTesting) {
        isTesting = true;
        btn.innerText = 'Stop Test';
        btn.style.backgroundColor = '#ef4444';
        statusMonitor.innerText = 'Monitoring: Testing...';

        let second = 1;
        testInterval = setInterval(() => {
          const randomLatency = Math.floor(Math.random() * 25) + 10;
          const randomRPS = Math.floor(Math.random() * 500) + 1000;

          if (latencyChart.data.labels.length > 10) {
            latencyChart.data.labels.shift();
            latencyChart.data.datasets[0].data.shift();
            rpsChart.data.labels.shift();
            rpsChart.data.datasets[0].data.shift();
          }

          latencyChart.data.labels.push(`${second}s`);
          latencyChart.data.datasets[0].data.push(randomLatency);
          latencyChart.update();

          rpsChart.data.labels.push(`${second}s`);
          rpsChart.data.datasets[0].data.push(randomRPS);
          rpsChart.update();

          document.getElementById('metric-get').innerText = `Latency: ${randomLatency} ms | Req/sec: ${randomRPS}`;
          document.getElementById('metric-post').innerText = `Latency: ${randomLatency + 15} ms | Req/sec: ${Math.floor(randomRPS * 0.7)}`;

          second++;
        }, 1000);

      } else {
        isTesting = false;
        clearInterval(testInterval);
        btn.innerText = 'Start Live Stress Test';
        btn.style.backgroundColor = 'var(--success)';
        statusMonitor.innerText = 'Monitoring: Idle';
      }
    }

    function generateCode() {
      document.getElementById('status-boilerplate').innerText = 'Boilerplate: Generated';
      alert('¬°Boilerplate y endpoints generados con √©xito!');
    }

    function compileDocker() {
      const fill = document.getElementById('progress-fill');
      const label = document.getElementById('progress-label');
      let progress = 0;

      const interval = setInterval(() => {
        progress += 25;
        fill.style.width = progress + '%';
        label.innerText = `Docker Build: ${progress}%`;

        if (progress >= 100) {
          clearInterval(interval);
          document.getElementById('status-docker').innerText = 'Docker: Image Ready';
          alert('Imagen Docker compilada exitosamente.');
        }
      }, 200);
    }
  </script>

