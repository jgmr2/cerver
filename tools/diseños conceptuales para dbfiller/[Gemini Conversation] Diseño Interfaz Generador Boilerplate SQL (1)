            tension: 0.3
          }]
        },
        options: commonOptions
      });

      const ctx2 = document.getElementById('rpsChart').getContext('2d');
      rpsChart = new Chart(ctx2, {
        type: 'line',
        data: {
          labels: ['0s'],
          datasets: [{
            label: 'Requests / sec (AB)',
            data: [0],
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.2)',
            fill: true,
            tension: 0.3
          }]
        },
        options: commonOptions
      });
    }

    window.onload = () => {
      initCharts();
      updateEndpointSelector();
    };

    function switchTab(tabId) {
      const tabs = document.querySelectorAll('.tab');
      const panels = document.querySelectorAll('.view-panel');

      tabs.forEach(tab => tab.classList.remove('active'));
      panels.forEach(panel => panel.classList.remove('active'));

      const selectedPanel = document.getElementById('panel-' + tabId);
      if (selectedPanel) {
        selectedPanel.classList.add('active');
      }

      const activeTabIndex = ['schema', 'gen', 'docker', 'stress'].indexOf(tabId);
      if (activeTabIndex !== -1) {
        tabs[activeTabIndex].classList.add('active');
      }
    }

    function onEndpointChange() {
      if (isTesting) {
        toggleStressTest();
      }
    }

    function toggleStressTest() {
      const btn = document.getElementById('btn-stress');
      const statusMonitor = document.getElementById('status-monitor');
      const selectedEndpoint = document.getElementById('endpoint-selector').value;

      if (!isTesting) {
        isTesting = true;
        btn.innerText = `Stop Testing (${selectedEndpoint})`;
        btn.style.backgroundColor = 'var(--danger)';
        statusMonitor.innerText = `Testing: ${selectedEndpoint}`;

        let second = 1;
        testInterval = setInterval(() => {
          const randomLatency = Math.floor(Math.random() * 20) + 8;
          const randomRPS = Math.floor(Math.random() * 400) + 1100;

          if (latencyChart.data.labels.length > 10) {
            latencyChart.data.labels.shift();
            latencyChart.data.datasets[0].data.shift();
            rpsChart.data.labels.shift();
            rpsChart.data.datasets[0].data.shift();
          }

          latencyChart.data.labels.push(`${second}s`);
          latencyChart.data.datasets[0].data.push(randomLatency);
          latencyChart.update();

          rpsChart.data.labels.push(`${second}s`);
          rpsChart.data.datasets[0].data.push(randomRPS);
          rpsChart.update();

          const activeMetrics = document.querySelectorAll('#metrics-container [id^="metric-"]');
          activeMetrics.forEach(metricSpan => {
            const epName = metricSpan.id.replace('metric-', '');
            if (selectedEndpoint === 'ALL' || selectedEndpoint === epName) {
              metricSpan.innerText = `Latency: ${randomLatency} ms | Req/sec: ${randomRPS}`;
            } else {
              metricSpan.innerText = `Latency: -- ms | Req/sec: --`;
            }
          });

          second++;
        }, 1000);

      } else {
        isTesting = false;
        clearInterval(testInterval);
        btn.innerText = 'Start Live Stress Test';
        btn.style.backgroundColor = 'var(--success)';
        statusMonitor.innerText = 'Monitoring: Idle';
      }
    }

    function generateCode() {
      document.getElementById('status-boilerplate').innerText = 'Boilerplate: Generated';
      alert('¬°Boilerplate y endpoints generados con √©xito!');
    }

    function compileDocker() {
      const fill = document.getElementById('progress-fill');
      const label = document.getElementById('progress-label');
      let progress = 0;

      const interval = setInterval(() => {
        progress += 25;
        fill.style.width = progress + '%';
        label.innerText = `Docker Build: ${progress}%`;

        if (progress >= 100) {
          clearInterval(interval);
          document.getElementById('status-docker').innerText = 'Docker: Image Ready';
          alert('Imagen Docker e inyecci√≥n de Variables de Entorno compiladas exitosamente.');
        }
      }, 200);
    }
  </script>

