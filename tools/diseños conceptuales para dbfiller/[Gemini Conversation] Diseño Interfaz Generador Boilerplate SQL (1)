      --bg-app: #f3f4f6;
      --bg-panel: #ffffff;
      --bg-sidebar: #e5e7eb;
      --bg-code: #f8fafc;
      --border-color: #d1d5db;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --success: #10b981;
      --badge-get: #dbeafe;
      --badge-get-txt: #1e40af;
      --badge-patch: #dcfce7;
      --badge-patch-txt: #166534;
      --badge-post: #fef3c7;
      --badge-post-txt: #92400e;
      --badge-delete: #fee2e2;
      --badge-delete-txt: #991b1b;
    }

    /* Media Query para Tema Oscuro seg√∫n el sistema */
    @media (prefers-color-scheme: dark) {
      :root {
        --bg-app: #111827;
        --bg-panel: #1f2937;
        --bg-sidebar: #111827;
        --bg-code: #0f172a;
        --border-color: #374151;
        --text-main: #f9fafb;
        --text-muted: #9ca3af;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
        --success: #10b981;
        --badge-get: #1e3a8a;
        --badge-get-txt: #93c5fd;
        --badge-patch: #064e3b;
        --badge-patch-txt: #6ee7b7;
        --badge-post: #78350f;
        --badge-post-txt: #fde68a;
        --badge-delete: #7f1d1d;
        --badge-delete-txt: #fca5a5;
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-app);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      font-size: 13px;
    }

    /* Men√∫ Superior */
    header {
      background-color: var(--bg-panel);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
    }

    .window-bar {
      display: flex;
      align-items: center;
      padding: 6px 12px;
      gap: 8px;
    }

    .window-dots {
      display: flex;
      gap: 6px;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .dot-red { background-color: #ef4444; }
    .dot-yellow { background-color: #f59e0b; }
    .dot-green { background-color: #10b981; }

    .window-title {
      flex: 1;
      text-align: center;
      font-weight: 600;
      color: var(--text-muted);
    }

    .nav-tabs {
      display: flex;
      background-color: var(--bg-sidebar);
      padding-left: 12px;
      border-top: 1px solid var(--border-color);
    }

    .tab {
      padding: 8px 16px;
      cursor: pointer;
      border-right: 1px solid var(--border-color);
      color: var(--text-muted);
      background-color: transparent;
      user-select: none;
      transition: background 0.2s;
    }

    .tab:hover {
      background-color: var(--bg-app);
    }

    .tab.active {
      background-color: var(--bg-panel);
      color: var(--text-main);
      font-weight: 600;
      border-bottom: 2px solid var(--accent);
    }

    /* Layout Principal */
    .main-container {
      display: grid;
      grid-template-columns: 280px 1fr 280px;
      flex: 1;
      overflow: hidden;
    }

    /* Columna Izquierda */
    .sidebar-left {
      background-color: var(--bg-panel);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      padding: 12px;
      gap: 12px;
    }

    .section-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      font-weight: 700;
    }

    .code-editor {
      background-color: var(--bg-code);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 10px;
      font-family: monospace;
      font-size: 11px;
      flex: 1;
      overflow-y: auto;
      white-space: pre;
    }

    .keyword { color: var(--accent); font-weight: bold; }
    .type { color: #ec4899; }

    .import-box {
      border: 1px dashed var(--border-color);
      border-radius: 6px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .db-status {
      font-size: 11px;
      color: var(--success);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Columna Central */
    .content-center {
      background-color: var(--bg-panel);
      display: flex;
      flex-direction: column;
      padding: 16px;
      gap: 16px;
      overflow-y: auto;
    }

    /* Vistas Din√°micas */
    .view-panel {
      display: none;
      flex-direction: column;
      gap: 16px;
    }

    .view-panel.active {
      display: flex;
    }

    .table-group {
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 12px;
      transition: opacity 0.2s;
    }

    .table-group.disabled {
      opacity: 0.5;
    }

    .table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-color);
    }

    .table-title-container {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Opciones globales de la tabla */
    .table-global-options {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      background-color: var(--bg-code);
      padding: 8px 12px;
      border-radius: 4px;
      margin-bottom: 12px;
      border: 1px solid var(--border-color);
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      cursor: pointer;
      user-select: none;
      color: var(--text-main);
    }

    .checkbox-label input[type="checkbox"] {
      cursor: pointer;
      accent-color: var(--accent);
    }

    .endpoint-card {
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 10px;
      margin-bottom: 8px;
      background-color: var(--bg-panel);
    }

    .endpoint-card:last-child {
      margin-bottom: 0;
    }

    .endpoint-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .endpoint-options-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 8px;
      padding-top: 8px;
      border-top: 1px dashed var(--border-color);
    }

    .method-badges {
      display: flex;
      gap: 4px;
    }

    .badge {
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: bold;
    }

    .badge-get { background-color: var(--badge-get); color: var(--badge-get-txt); }
    .badge-patch { background-color: var(--badge-patch); color: var(--badge-patch-txt); }
    .badge-post { background-color: var(--badge-post); color: var(--badge-post-txt); }
    .badge-delete { background-color: var(--badge-delete); color: var(--badge-delete-txt); }

    /* Forms e Inputs */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .form-control {
      background-color: var(--bg-code);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 6px 10px;
      border-radius: 4px;
      font-size: 12px;
    }

    /* Gr√°ficas */
    .charts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 12px;
    }

    .chart-box {
      background-color: var(--bg-code);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 10px;
      height: 220px;
      position: relative;
    }

    /* Columna Derecha */
    .sidebar-right {
      background-color: var(--bg-panel);
      border-left: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      padding: 12px;
      gap: 16px;
    }

    .file-tree {
      background-color: var(--bg-code);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 10px;
      flex: 1;
      font-family: monospace;
    }

    .file-item {
      padding: 2px 0;
      color: var(--text-muted);
    }

    .file-item.folder { font-weight: bold; color: var(--text-main); }

    /* Botones */
    .btn {
      background-color: var(--accent);
      color: white;
      border: none;
      padding: 8px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 500;
      width: 100%;
      text-align: center;
      transition: background 0.2s;
    }

    .btn:hover { background-color: var(--accent-hover); }

    .progress-bar {
      height: 8px;
      background-color: var(--border-color);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 4px;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background-color: var(--success);
      transition: width 0.3s ease;
    }

    /* Barra de Estado Inferior */
    footer {
      background-color: var(--bg-sidebar);
      border-top: 1px solid var(--border-color);
      padding: 4px 12px;
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      gap: 16px;
    }

    .status-item { display: flex; align-items: center; gap: 4px; }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background-color: var(--success); }
  </style>
</head>
